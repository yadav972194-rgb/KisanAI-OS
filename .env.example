# KisanAI OS — Environment Configuration Example
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file.

# Application
APP_NAME=KisanAI OS
APP_VERSION=3.4.0
# development | production
APP_MODE=development
DEBUG=true
LOG_LEVEL=INFO
TIME_ZONE=Asia/Kolkata
DEFAULT_LANGUAGE=hi

# Server (uvicorn startup)
# Production deployments usually bind 0.0.0.0 behind a reverse proxy.
HOST=0.0.0.0
PORT=8000
# Hot reload follows DEBUG unless set explicitly. Must be false in production.
# RELOAD=true

# CORS
# Comma-separated allowed browser origins; empty disables CORS (native
# Android app does not need it). Example:
# CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=

# Database
# Development (SQLite):
DATABASE_URL=sqlite:///./kisanai.db
# Production (PostgreSQL) example:
# DATABASE_URL=postgresql+psycopg://kisanai:CHANGE_ME@db-host:5432/kisanai

# Security / Auth (Phase 3)
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
# Production startup FAILS if SECRET_KEY is weak or missing.
SECRET_KEY=replace-with-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OTP / SMS (Phase 3 OTP auth)
# Development: OTP_MOCK=true returns the code as dev_otp in the API
# response so local flows and tests can complete. Production MUST set
# OTP_MOCK=false and OTP_PROVIDER to a real SMS gateway.
OTP_MOCK=true
OTP_PROVIDER=mock
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=900

# Production OTP via Twilio (only used when OTP_PROVIDER=twilio).
# NEVER commit real credentials. Never expose them to clients.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Sender: prefer a Messaging Service SID, or a From phone number.
# One of the two is required for the Twilio provider to activate.
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=

# Rate limiting (Phase 11)
# Max failed login attempts before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Admin bootstrap account (Phase 3) — leave empty if not used
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Media / uploads (must be a persistent volume in production)
UPLOAD_DIR=media/uploads
MAX_UPLOAD_SIZE_MB=5

# Weather
WEATHER_LOCATION=Sitapur
WEATHER_COUNTRY_CODE=IN
# Weather cache TTL in seconds (default 600)
WEATHER_CACHE_TTL_SECONDS=600

# AI Disease Detection
# Server-controlled path to a trained disease-detection ONNX model file.
# Leave empty to keep the API in the safe MODEL_NOT_CONFIGURED state.
DISEASE_MODEL_PATH=
# Optional labels file (one class name per line, model output order).
# Empty = auto-use "<model path>.txt" next to the model.
DISEASE_MODEL_LABELS=
# Square resize size (pixels) applied before inference (default 224).
DISEASE_MODEL_INPUT_SIZE=224

# AI Pest Detection
# Server-controlled path to a trained pest-detection ONNX model file.
# Leave empty to keep the API in the safe MODEL_NOT_CONFIGURED state.
PEST_MODEL_PATH=
# Optional labels file (one class name per line, model output order).
# Empty = auto-use "<model path>.txt" next to the model.
PEST_MODEL_LABELS=
# Square resize size (pixels) applied before inference (default 224).
PEST_MODEL_INPUT_SIZE=224

# AI Weed Detection
# Server-controlled path to a trained weed-detection ONNX model file.
# Leave empty to keep the API in the safe MODEL_NOT_CONFIGURED state.
WEED_MODEL_PATH=
# Optional labels file (one class name per line, model output order).
# Empty = auto-use "<model path>.txt" next to the model.
WEED_MODEL_LABELS=
# Square resize size (pixels) applied before inference (default 224).
WEED_MODEL_INPUT_SIZE=224

# AI Nutrient Deficiency Detection
# Server-controlled path to a trained nutrient-deficiency ONNX model file.
# Leave empty to keep the API in the safe MODEL_NOT_CONFIGURED state.
NUTRIENT_DEFICIENCY_MODEL_PATH=
# Optional labels file (one class name per line, model output order).
# Empty = auto-use "<model path>.txt" next to the model.
NUTRIENT_DEFICIENCY_MODEL_LABELS=
# Square resize size (pixels) applied before inference (default 224).
NUTRIENT_DEFICIENCY_MODEL_INPUT_SIZE=224

# AI Crop Growth Stage Detection
# Server-controlled path to a trained crop-growth-stage ONNX model file.
# Leave empty to keep the API in the safe MODEL_NOT_CONFIGURED state.
GROWTH_STAGE_MODEL_PATH=
# Optional labels file (one class name per line, model output order).
# Empty = auto-use "<model path>.txt" next to the model.
GROWTH_STAGE_MODEL_LABELS=
# Square resize size (pixels) applied before inference (default 224).
GROWTH_STAGE_MODEL_INPUT_SIZE=224

# AI Crop Water Stress Detection
# Server-controlled path to a trained crop-water-stress ONNX model file.
# Leave empty to keep the API in the safe MODEL_NOT_CONFIGURED state.
WATER_STRESS_MODEL_PATH=
# Optional labels file (one class name per line, model output order;
# normally NO_STRESS / MILD_STRESS / MODERATE_STRESS / SEVERE_STRESS).
# Empty = auto-use "<model path>.txt" next to the model.
WATER_STRESS_MODEL_LABELS=
# Square resize size (pixels) applied before inference (default 224).
WATER_STRESS_MODEL_INPUT_SIZE=224

# AI Prediction Engine
# Server-controlled path to a validated prediction model file.
# Leave empty to keep the engine in the safe MODEL_NOT_CONFIGURED state.
PREDICTION_MODEL_PATH=
# Optional labels file (one class name per line, model output order).
# Only used for classification-style outputs.
# Empty = auto-use "<model path>.txt" next to the model.
PREDICTION_MODEL_LABELS=
# Reserved for a future image-input prediction model (default 224).
PREDICTION_MODEL_INPUT_SIZE=224

# Recommendation Engine
# Provider selector: "rules" (default deterministic rule-based engine)
# or a future AI provider name.
RECOMMENDATION_PROVIDER=rules
# Server-controlled path to a validated recommendation model file
# (only relevant when RECOMMENDATION_PROVIDER is not "rules").
RECOMMENDATION_MODEL_PATH=
# Optional override for the recommendation-model labels file (one class
# name per line, in the model's output order). Only used for
# classification-style outputs.
# Empty = auto-use "<model path>.txt" next to the model.
RECOMMENDATION_MODEL_LABELS=
# Reserved for a future image-input recommendation model (default 224).
RECOMMENDATION_MODEL_INPUT_SIZE=224

# Advisory Engine
# Provider selector: "rules" (default deterministic rule-based engine)
# or a future AI provider name.
ADVISORY_PROVIDER=rules
# Server-controlled path to a validated advisory model file
# (only relevant when ADVISORY_PROVIDER is not "rules").
ADVISORY_MODEL_PATH=
# Optional override for the advisory-model labels file (one class
# name per line, in the model's output order). Only used for
# classification-style outputs.
# Empty = auto-use "<model path>.txt" next to the model.
ADVISORY_MODEL_LABELS=
# Reserved for a future image-input advisory model (default 224).
ADVISORY_MODEL_INPUT_SIZE=224
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# WEATHER_LATITUDE/WEATHER_LONGITUDE: optional fixed coordinates for
# WEATHER_LOCATION. When both are set the geocoder is skipped, avoiding
# Open-Meteo geocoding rate limits (HTTP 429).
